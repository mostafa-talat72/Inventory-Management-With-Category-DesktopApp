<UserControl x:Class="ProductApp.Views.ShortcutsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             MinWidth="520" MaxWidth="560">
    <StackPanel Margin="0">
        <Border Background="{DynamicResource CardBackground}" Padding="32,24,32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="16" Background="#E8EAF6">
                    <Path FlowDirection="LeftToRight" Width="24" Height="24" Fill="#1A237E" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M7.33,20H2V18H7.33C7.59,18.36 7.94,18.65 8.33,18.85C8.72,19.05 9.16,19.17 9.6,19.17H11.27V21H9.6C8.73,21 7.93,20.72 7.33,20M22,18V20H18.67C18.07,20.72 17.27,21 16.4,21H14.73V19.17H16.4C16.84,19.17 17.28,19.05 17.67,18.85C18.06,18.65 18.41,18.36 18.67,18H22M13.83,19.17H11.27V21H13.83V19.17M20,16H4V15.67C4,13.28 5.21,11.05 7.27,9.78C6.55,9.22 6,8.28 6,7.17C6,6.67 6.11,6.19 6.33,5.75C5.44,5.06 5.25,3.72 5.94,2.83C6.63,1.94 7.97,1.75 8.86,2.44C9.3,2.67 9.67,3 9.94,3.44C10.17,2.94 10.5,2.5 10.94,2.17C11.78,1.5 13,1.69 13.67,2.56C14.34,3.42 14.14,4.69 13.28,5.36C13.11,5.5 12.94,5.61 12.75,5.72C12.94,5.83 13.11,5.94 13.28,6.08C14.14,6.75 14.34,8.02 13.67,8.89C13,9.75 11.78,9.94 10.94,9.28C10.5,8.94 10.17,8.5 9.94,8C9.61,8.56 9.17,9 8.67,9.33C9.28,10.06 9.72,11.06 9.83,12.17H15.17C15.28,11.06 15.72,10.06 16.33,9.33C15.83,9 15.39,8.56 15.06,8C14.83,8.5 14.5,8.94 14.06,9.28C13.22,9.94 12,9.75 11.33,8.89C10.66,8.02 10.86,6.75 11.72,6.08C11.89,5.94 12.06,5.83 12.25,5.72C12.06,5.61 11.89,5.5 11.72,5.36C10.86,4.69 11.06,3.42 11.94,2.56C12.5,2.03 13.39,2 14,2.44C14.5,2.78 14.83,3.22 15.06,3.72C15.33,3.28 15.7,2.94 16.14,2.72C16.61,2.44 17.22,2.5 17.64,2.83C18.5,3.5 18.75,4.78 18.08,5.67C17.89,5.92 17.67,6.11 17.39,6.33C17.56,6.39 17.72,6.47 17.89,6.56C18.06,6.64 18.22,6.75 18.39,6.89C20.42,8.11 22,10.5 22,13.5C22,14.28 22,15 22,16M20,13.5C20,11.5 18.67,9.5 16.5,8.44C16.81,7.72 16.39,6.94 15.67,6.67C15.06,6.39 14.39,6.56 14.06,7.06C13.72,7.56 13.83,8.22 14.28,8.67C14.72,9.11 15.33,9.17 15.78,8.83C16.06,8.61 16.22,8.28 16.28,7.94C17.89,9 19,10.67 19,12.67C19,13.11 19,13.5 19,14H5C5,12.5 5.56,11.11 6.56,10.06C7,9.61 7.5,9.25 8.06,9.06C8.61,8.86 9.22,8.89 9.72,9.17C10.22,9.5 10.44,10.17 10.28,10.83C10.11,11.44 9.5,11.89 8.89,11.78C8.5,11.72 8.22,11.44 8.06,11.06C7.78,11.39 7.56,11.78 7.39,12.17C7.14,12.83 7,13.61 7,14.67C7,14.78 7,14.89 7,15H17.67C17.78,14.89 17.89,14.78 17.94,14.67C18.5,13.75 19.28,13.28 20,13.28V13.5Z" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="اختصارات لوحة المفاتيح" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="تسريع العمل داخل شاشة المنتجات" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Click="BtnClose_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="36" Height="36"
                        ToolTip="إغلاق" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0">
                                <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="#78909C" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <Rectangle Height="3" Fill="#1A237E" Margin="32,0,32,0" />
        <StackPanel Margin="32,24,32,28">
            <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="24,20">
                <StackPanel>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#E8EAF6" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + F" FontSize="12" FontWeight="Bold" Foreground="#1A237E" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="التركيز على خانة البحث" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#E8F5E9" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="Ctrl + N" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="إضافة منتج جديد" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#FFF3E0" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="F2" FontSize="12" FontWeight="Bold" Foreground="#E65100" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="تعديل المنتج المحدد (مرّر الماوس فوق البطاقة)" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#FFEBEE" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="Delete" FontSize="12" FontWeight="Bold" Foreground="#C62828" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="حذف المنتج المحدد" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#E0F2F1" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="Esc" FontSize="12" FontWeight="Bold" Foreground="#00695C" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="مسح البحث والعودة للكل" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceBackground}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#ECEFF1" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="F1" FontSize="12" FontWeight="Bold" Foreground="#546E7A" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="فتح هذه الشاشة" FontSize="13" Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button Click="BtnClose_Click"
                        Height="44" Padding="28,0" Cursor="Hand"
                        Background="#1A237E" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="White" Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17Z" />
                                    <TextBlock Text="تمام" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
