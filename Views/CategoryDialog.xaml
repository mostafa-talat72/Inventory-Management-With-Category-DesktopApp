<UserControl x:Class="ProductApp.Views.CategoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="450" MaxWidth="600">
    <StackPanel Margin="0">
        <Border Background="{DynamicResource CardBackground}" Padding="32,24,32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="16" Background="#E8EAF6">
                    <Path FlowDirection="LeftToRight" Width="24" Height="24" Fill="#1A237E" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H17V17H3V15M3,19H13V21H3V19Z" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="TxtHeader" Text="إضافة قسم جديد" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="أدخل اسم القسم والتفاصيل" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Click="BtnCancel_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="36" Height="36"
                        ToolTip="إغلاق" VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0">
                                <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="#78909C" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <Rectangle Height="3" Fill="#1A237E" Margin="32,0,32,0" />
        <StackPanel Margin="32,24,32,28">
            <Border CornerRadius="14" Background="{DynamicResource CardBackground}" Padding="24,20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="اسم القسم" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,0,0,8" />
                    <TextBox x:Name="TxtName" wm:WatermarkBehavior.Watermark="اسم القسم *"
                             Style="{StaticResource FormField}" FontSize="14" Height="42"
                             Foreground="{DynamicResource HeadingTextBrush}"
                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                    <TextBlock Text="الوصف (اختياري)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,14,0,8" />
                    <TextBox x:Name="TxtDescription" wm:WatermarkBehavior.Watermark="وصف القسم"
                             Style="{StaticResource FormField}" Margin="0,0,0,0" FontSize="14" Height="42"
                             Foreground="{DynamicResource HeadingTextBrush}"
                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                    <TextBlock Text="القسم الأب (اختياري)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HeadingTextBrush}" Margin="0,14,0,8" />
                    <ComboBox x:Name="CmbParentCategory"
                              FontSize="14" Height="42" Margin="0,0,0,8"
                              Foreground="{DynamicResource HeadingTextBrush}"
                              Background="{DynamicResource InputBackground}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           Foreground="{DynamicResource HeadingTextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSave" Click="BtnSave_Click"
                        Height="44" Padding="28,0" Cursor="Hand"
                        Background="#1A237E" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="White" Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17Z" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    حفظ
                </Button>
                <Button Click="BtnCancel_Click"
                        Height="44" Padding="28,0" Cursor="Hand" Margin="14,0,0,0"
                        Background="#78909C" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path FlowDirection="LeftToRight" Width="18" Height="18" Fill="White" Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">إلغاء</TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>