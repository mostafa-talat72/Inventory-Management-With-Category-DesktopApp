                                                </Grid>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFF8E1" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <!-- حذف -->
                                            <Border Grid.Column="5" Width="28" Height="28" CornerRadius="7"
                                                    Background="Transparent" Cursor="Hand"
                                                    ToolTip="حذف"><Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DeleteCommand}" />
                                                </Border.InputBindings>
                                                <Path FlowDirection="LeftToRight" Width="13" Height="13" Fill="#EF5350" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFEBEE" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <!-- CheckBox التحديد المتعدد -->
                                            <CheckBox Grid.Column="6" Width="20" Height="20" VerticalAlignment="Center" Margin="3,0,2,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Visibility="{Binding SelectionVisible}"
                                                      Cursor="Hand" ToolTip="تحديد" />
                                        </Grid>

                                        <!-- Row 1: Units path -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="5" Background="{DynamicResource CardBackgroundAlt}"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding UnitsDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="5" Padding="8,4" Margin="6,0,0,0"
                                                    Background="{Binding BadgeBg}" Visibility="{Binding HasBadge}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding BadgeFg}" />
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Stock + Value -->
                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="8"
                                                    Background="{Binding StockBgColor}"
                                                    Padding="6,5" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Fill="{Binding StockFgColor}" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                                                    <TextBlock Text="{Binding StockDisplay}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding StockFgColor}" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceBackground}"
                                                    Padding="6,5" VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="قيمة:" FontSize="9"
                                                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StockValueDisplay}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 3: Prices -->
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="6" Background="#F0F0FF" Padding="8,4" Margin="0,0,3,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="قطاعي:" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RetailDisplay}"
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="6" Background="#F1F8E9" Padding="8,4" Margin="3,0,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="جملة:" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding WholesaleDisplay}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Row 4: Quick actions -->
                                        <Grid Grid.Row="4" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- زر خصم من المخزون -->
                                            <Border Grid.Column="0" CornerRadius="8" Background="#FFEBEE" Cursor="Hand"
                                                    Padding="0,7">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DeductStockCommand}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.75" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Fill="#D32F2F" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Data="M19,13H5V11H19V13Z" />
                                                    <TextBlock Text="خصم مخزون" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#C62828" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- زر سجل حركة المخزون -->
                                            <Border Grid.Column="2" CornerRadius="8" Background="#E8EAF6" Cursor="Hand"
                                                    Padding="0,7">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding HistoryCommand}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.75" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Fill="#3949AB" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Data="M13,3C8.03,3 4,7.03 4,12H1L4.89,15.89L4.96,16.03L9,12H6C6,8.13 9.13,5 13,5C16.87,5 20,8.13 20,12C20,15.87 16.87,19 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21C17.97,21 22,16.97 22,12C22,7.03 17.97,3 13,3M12,8V13L16.28,15.54L17,14.33L13.5,12.25V8H12Z" />
                                                    <TextBlock Text="سجل الحركة" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#3949AB" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="TxtEmptyProducts" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                        <Path FlowDirection="LeftToRight" Width="40" Height="40" Fill="#B0BEC5" Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M13,6H11V7H13V6M13,8H11V17H13V8Z" />
                        <TextBlock Text="لا توجد منتجات مطابقة" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
                </Border>
        </Grid>
    </Grid>
</Page>