<UserControl x:Class="ProductApp.Views.StockInDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wm="clr-namespace:ProductApp.Converters"
             FlowDirection="RightToLeft"
             MinWidth="900" MaxWidth="1300" MinHeight="500" MaxHeight="720">
    <Border CornerRadius="14" Background="{DynamicResource AppBackground}" Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.3" Color="#00695C" />
        </Border.Effect>
        <Grid Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, FallbackValue=680}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══ Header ══ -->
            <Border Grid.Row="0" Background="#00695C" CornerRadius="14,14,0,0" Padding="22,13,22,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="#00897B">
                        <Path FlowDirection="LeftToRight" Width="16" Height="16" Fill="White" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="إضافة مخزون" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="اختر القسم والمنتجات ثم أدخل الكميات والتكلفة"
                                   FontSize="10" Foreground="#A5D6A7" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="12" Background="#00897B" Padding="9,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="محدد: " FontSize="11" Foreground="#A5D6A7" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtSelectedBadge" Text="0" FontSize="13"
                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ Body: 3 columns ══ -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- ══ COL 0: الأقسام ══ -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,1,0"
                        VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="12,14,12,10"
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="7"
                                        Background="{DynamicResource SurfaceBackground}" Margin="0,0,8,0">
                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Stretch="Uniform"
                                          Fill="{DynamicResource PrimaryTextBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H17V17H3V15M3,19H13V21H3V19Z" />
                                </Border>
                                <TextBlock Text="الأقسام" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeadingTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Padding="8,8,8,4">
                            <Border CornerRadius="7" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" Background="{DynamicResource InputBackground}">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" FlowDirection="LeftToRight" Width="11" Height="11"
                                          Fill="{DynamicResource MutedTextBrush}" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                                    <TextBox Grid.Column="1" x:Name="TxtCategorySearch"
                                             FontSize="11" Padding="0,0,5,0" BorderThickness="0"
                                             Background="Transparent" VerticalAlignment="Center"
                                             Foreground="{DynamicResource HeadingTextBrush}"
                                             CaretBrush="{DynamicResource HeadingTextBrush}"
                                             TextChanged="TxtCategorySearch_TextChanged" />
                                </Grid>
                            </Border>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,4,8,8">
                            <StackPanel>
                                <Border x:Name="ChipAll" Margin="0,0,0,4" CornerRadius="8" Padding="10,8"
                                        Cursor="Hand" MouseLeftButtonUp="ChipAll_Click"
                                        Background="{DynamicResource PrimaryBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.88" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="5"
                                                Background="#FFFFFF20" Margin="0,0,8,0">
                                            <Path FlowDirection="LeftToRight" Width="11" Height="11" Fill="White"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                                        </Border>
                                        <TextBlock Text="الكل" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="CategoryChips">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" CornerRadius="8" Padding="10,8"
                                                    Cursor="Hand" BorderThickness="1">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource InputBackground}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource InputBackground}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#FFFFFF20" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path FlowDirection="LeftToRight" Width="11" Height="11"
                                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H17V17H3V15M3,19H13V21H3V19Z">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="{DynamicResource BodyTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Fill" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource HeadingTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ══ COL 1: المنتجات ══ -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="12,12,12,10"
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
                            <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" Background="{DynamicResource CardBackground}">
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" FlowDirection="LeftToRight" Width="13" Height="13"
                                          Fill="{DynamicResource MutedTextBrush}" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                                    <TextBox Grid.Column="1" x:Name="TxtSearch"
                                             wm:WatermarkBehavior.Watermark="بحث عن منتج..."
                                             TextChanged="TxtSearch_TextChanged"
                                             FontSize="13" Padding="0,0,8,0" BorderThickness="0"
                                             Background="Transparent" VerticalAlignment="Center"
                                             Foreground="{DynamicResource HeadingTextBrush}"
                                             CaretBrush="{DynamicResource HeadingTextBrush}" />
                                </Grid>
                            </Border>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,10">
                            <ItemsControl x:Name="ProductCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="155" Margin="4" CornerRadius="10" Cursor="Hand"
                                                BorderThickness="1" Padding="0">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#00897B" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#00695C" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="3" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="#00897B" />
                                                <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource HeadingTextBrush}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               Margin="0,0,0,5" />
                                                    <Border CornerRadius="5" Padding="5,2" HorizontalAlignment="Left"
                                                            Background="{DynamicResource SurfaceBackground}" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding StockDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource BodyTextBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding UnitsDisplay}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ══ COL 2: الكميات والتكلفة ══ -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Border Grid.Row="0" Padding="16,14,16,10"
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#E0F2F1">
                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Fill="#00695C"
                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="الكميات والتكلفة"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" x:Name="TxtSelectedCount" Text=""
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- items list -->
                        <ScrollViewer x:Name="SelectedItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8,12,4">
                            <ItemsControl x:Name="SelectedItemsList">
                                <ItemsControl.Resources>
                                    <BooleanToVisibilityConverter x:Key="B2V" />
                                </ItemsControl.Resources>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" CornerRadius="10"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                            <Grid Margin="12,10,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- icon -->
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#E0F2F1">
                                                    <Path FlowDirection="LeftToRight" Width="12" Height="12" Fill="#00695C"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15M5,15.91L11,19.29V12.58L5,9.2V15.91M13,19.29L19,15.91V9.2L13,12.58V19.29Z" />
                                                </Border>
                                                <!-- name -->
                                                <TextBlock Grid.Column="1" Text="{Binding ProductName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HeadingTextBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <!-- remove -->
                                                <Button Grid.Column="2" Click="RemoveEntry_Click"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="إزالة" Width="22" Height="22">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <Path FlowDirection="LeftToRight" Width="11" Height="11"
                                                                      Fill="#E53935" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12 19,6.41Z" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#FFEBEE" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <!-- qty + cost row -->
                                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal">
                                                    <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBackground}" Padding="8,6" Margin="0,0,6,0"
                                                            Visibility="{Binding HasCarton, Converter={StaticResource B2V}}">
                                                        <StackPanel>
                                                            <TextBlock Text="كرتونة" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <Border CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" Background="{DynamicResource CardBackground}"
                                                                    Width="52" Height="26" Margin="0,4,0,0">
                                                                <TextBox Text="{Binding CartonQty, UpdateSourceTrigger=LostFocus}"
                                                                         FontSize="11" TextAlignment="Center"
                                                                         BorderThickness="0" Background="Transparent"
                                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                                         CaretBrush="{DynamicResource HeadingTextBrush}"
                                                                         VerticalAlignment="Center" Padding="2,0"
                                                                         PreviewTextInput="Qty_PreviewTextInput" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBackground}" Padding="8,6" Margin="0,0,6,0"
                                                            Visibility="{Binding HasBox, Converter={StaticResource B2V}}">
                                                        <StackPanel>
                                                            <TextBlock Text="علبة" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <Border CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" Background="{DynamicResource CardBackground}"
                                                                    Width="52" Height="26" Margin="0,4,0,0">
                                                                <TextBox Text="{Binding BoxQty, UpdateSourceTrigger=LostFocus}"
                                                                         FontSize="11" TextAlignment="Center"
                                                                         BorderThickness="0" Background="Transparent"
                                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                                         CaretBrush="{DynamicResource HeadingTextBrush}"
                                                                         VerticalAlignment="Center" Padding="2,0"
                                                                         PreviewTextInput="Qty_PreviewTextInput" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBackground}" Padding="8,6" Margin="0,0,6,0"
                                                            Visibility="{Binding HasPiece, Converter={StaticResource B2V}}">
                                                        <StackPanel>
                                                            <TextBlock Text="قطعة" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <Border CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" Background="{DynamicResource CardBackground}"
                                                                    Width="52" Height="26" Margin="0,4,0,0">
                                                                <TextBox Text="{Binding PieceQty, UpdateSourceTrigger=LostFocus}"
                                                                         FontSize="11" TextAlignment="Center"
                                                                         BorderThickness="0" Background="Transparent"
                                                                         Foreground="{DynamicResource HeadingTextBrush}"
                                                                         CaretBrush="{DynamicResource HeadingTextBrush}"
                                                                         VerticalAlignment="Center" Padding="2,0"
                                                                         PreviewTextInput="Qty_PreviewTextInput" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="6" BorderBrush="#F57F17" BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBackground}" Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="التكلفة ج.م" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#F57F17" HorizontalAlignment="Center" />
                                                            <Border CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" Background="{DynamicResource CardBackground}"
                                                                    Width="76" Height="26" Margin="0,4,0,0">
                                                                <TextBox Text="{Binding TotalCost, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                                                         FontSize="11" TextAlignment="Center" FontWeight="Bold"
                                                                         Foreground="#F57F17" CaretBrush="#F57F17"
                                                                         BorderThickness="0" Background="Transparent"
                                                                         VerticalAlignment="Center" Padding="2,0" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- footer -->
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}"
                                Padding="16,10,16,14"
                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnCancel_Click" Height="40" Cursor="Hand"
                                        Background="{DynamicResource CardBackgroundAlt}"
                                        Foreground="{DynamicResource BodyTextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        FontSize="13" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    إلغاء
                                </Button>
                                <Button Grid.Column="1" Click="BtnSave_Click" Height="40" Cursor="Hand"
                                        Padding="22,0" Margin="8,0,0,0"
                                        Background="#00897B" Foreground="White" BorderThickness="0"
                                        FontSize="13" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path FlowDirection="LeftToRight" Width="15" Height="15" Fill="White"
                                                          Stretch="Uniform" VerticalAlignment="Center"
                                                          Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17Z" />
                                                    <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    حفظ الكل
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>
